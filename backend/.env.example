# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real keys.
# All values can also be set as real environment variables (those win).

# --- Admin guard (opt-in) ----------------------------------------------
# Leave unset for the normal local-first setup — all endpoints stay open,
# exactly as before. Set it when hosting a SHARED/PUBLIC backend: mutating
# and expensive endpoints (refresh-all, cleanup, theme runs, Ollama pulls,
# /api/hardware) then require a matching `X-Admin-Token` header. Generate
# one with: openssl rand -hex 32
ADMIN_TOKEN=

# --- LLM theme-method backends ------------------------------------------
# Anthropic API key — only needed for the LLM Analysis theme method when
# "Claude" is selected as the backend. The keyword / TF-IDF / Semantic /
# BERTopic methods work without this.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Groq (OpenAI-compatible, generous free tier) — for the "groq:<model>"
# LLM backend, e.g. groq:openai/gpt-oss-20b. Keys: console.groq.com
GROQ_API_KEY=

# Optional nightly incremental themes batch (disabled while backend is blank).
# Opt in with GROQ_API_KEY above and, for example:
# THEMES_LLM_BACKEND=groq:openai/gpt-oss-20b
# Only explicit groq:<model> backends are accepted; no paid-provider fallback.
# Use a Groq free-tier account/model; pacing is not a guarantee against a
# model's per-request token limit. Any failure stops the batch for the UTC day.
THEMES_LLM_BACKEND=
# Attempts, including failures, capped across restarts and backend changes.
THEMES_BATCH_MAX_REQUESTS=10
# Minimum 90 seconds between request starts; sequential, no retries.
THEMES_BATCH_GAP_SECONDS=90
# Optional absolute persistent directory; default backend/.cache/themes-batch.
# Use the SAME directory for manual and systemd runs; do not delete its quota
# checkpoint to restart a failed batch. Keep it through redeploys.
# THEMES_BATCH_STATE_DIR=/var/lib/twowheeler/themes-batch
# Bootstrap installs themes-batch.service + .timer. Enable the timer after
# configuring the above: sudo systemctl enable --now themes-batch.timer
# Check runs: journalctl -u themes-batch.service

# Any other OpenAI-compatible endpoint (Together, DeepInfra, vLLM, ...) —
# for the "openai:<model>" LLM backend.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# --- Ollama / embeddings --------------------------------------------------
# Where Ollama listens. Only change when it runs on another host/port.
OLLAMA_BASE_URL=http://localhost:11434
# "ollama" (default; needs Ollama + nomic-embed-text) or
# "sentence_transformers" (in-process MiniLM; needs requirements-ml.txt).
EMBEDDING_BACKEND=ollama

# --- CORS ---------------------------------------------------------------
# Comma-separated extra origins allowed to call this backend, e.g. the
# public Caddy domain of a hosted deployment. localhost:5173 and the
# GitHub Pages origin are always allowed.
EXTRA_CORS_ORIGINS=

# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real keys.
# All values can also be set as real environment variables (those win).

# --- Admin guard (opt-in) ----------------------------------------------
# Leave unset for the normal local-first setup — all endpoints stay open,
# exactly as before. Set it when hosting a SHARED/PUBLIC backend: mutating
# and expensive endpoints (refresh-all, cleanup, theme runs, Ollama pulls,
# /api/hardware) then require a matching `X-Admin-Token` header. Generate
# one with: openssl rand -hex 32
ADMIN_TOKEN=

# --- LLM theme-method backends ------------------------------------------
# Anthropic API key — only needed for the LLM Analysis theme method when
# "Claude" is selected as the backend. The keyword / TF-IDF / Semantic /
# BERTopic methods work without this.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Groq (OpenAI-compatible, generous free tier) — for the "groq:<model>"
# LLM backend, e.g. groq:llama-3.1-8b-instant. Keys: console.groq.com
GROQ_API_KEY=

# Any other OpenAI-compatible endpoint (Together, DeepInfra, vLLM, ...) —
# for the "openai:<model>" LLM backend.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# --- Ollama / embeddings --------------------------------------------------
# Where Ollama listens. Only change when it runs on another host/port.
OLLAMA_BASE_URL=http://localhost:11434
# "ollama" (default; needs Ollama + nomic-embed-text) or
# "sentence_transformers" (in-process MiniLM; needs requirements-ml.txt).
EMBEDDING_BACKEND=ollama

# --- CORS ---------------------------------------------------------------
# Comma-separated extra origins allowed to call this backend, e.g. the
# public Caddy domain of a hosted deployment. localhost:5173 and the
# GitHub Pages origin are always allowed.
EXTRA_CORS_ORIGINS=
